# ═══════════════════════════════════════════════════════════════════════════
#  FinanceLab / FinHubAI — Unified ALL-PHASE Environment Template
#  Copy to .env and fill only the keys you plan to use. Any key left blank
#  simply disables that provider — the app will degrade gracefully.
# ═══════════════════════════════════════════════════════════════════════════

# ── Phase 1-2: Core Backend ───────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/finhub
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-another-long-random-string
JWT_ALGORITHM=HS256

# ── Phase 1: Market & News Providers ──────────────────────────────────────
FINNHUB_API_KEY=
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
TWELVE_DATA_API_KEY=
NEWSAPI_API_KEY=
MARKETAUX_API_KEY=
QUANDL_API_KEY=

# ── Phase 1: NSE / BSE India ──────────────────────────────────────────────
# Paste browser Cookie header if public endpoints return 401/403
NSE_COOKIES=
BSE_COOKIES=

# ── Phase 1: Broker Integrations (Phase 6 importers read from these too) ──
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_ID=
HDFC_SKY_API_KEY=
IBKR_USERNAME=
IBKR_ACCOUNT_ID=

# ── Phase 3: AI / Ollama / RAG / NLQ ──────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=finhub
HF_HOME=./data/hf_cache
SENTIMENT_FINBERT_ENABLED=true
FINBERT_MODEL=ProsusAI/finbert

# Optional remote LLMs (off by default — local Ollama is preferred)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Phase 2-8: Alerts (Telegram / Slack / Discord / SMS) ──────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Phase 4-5: Cloud / Supabase / Backup ──────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ── Phase 5: Cloudflare Tunnel ────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_NAME=finhub
CLOUDFLARE_API_TOKEN=

# ── Phase 5: Observability (Sentry / Prometheus) ──────────────────────────
SENTRY_DSN=
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# ── Phase 6: Tax Engine ───────────────────────────────────────────────────
DEFAULT_COUNTRY=IN
DEFAULT_CURRENCY=INR
FY_START_MONTH=4
TAX_EXPORT_DIR=./data/tax_exports
ADVANCE_TAX_ALERTS=true

# ── Phase 7: Alternative Data ─────────────────────────────────────────────
GOOGLE_TRENDS_ENABLED=true
APP_STORE_CONNECT_KEY=
PLAY_STORE_API_KEY=
LINKEDIN_JOBS_API_KEY=
IMPORT_EXPORT_API_KEY=

# ── Phase 7: Social / Sentiment (Twitter / Reddit / StockTwits) ───────────
TWITTER_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=finhub/1.0
STOCKTWITS_TOKEN=

# ── Phase 8: Apple Ecosystem / Mobile Push ────────────────────────────────
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY_PATH=
APNS_TOPIC=com.finhub.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@finhub.local

# ── Phase 8: ML Serving ───────────────────────────────────────────────────
ML_MODELS_DIR=./data/ml_models
ML_ENABLE_PRICE_DIRECTION=true
ML_ENABLE_ANOMALY=true
ML_ENABLE_PERSONAL_EDGE=true

# ── Service Ports (override if busy) ──────────────────────────────────────
FINLAB_API_PORT=8000
FINLAB_WEB_PORT=3000
FINLAB_SCHEDULER_PORT=8010
FINLAB_WORKER_CONCURRENCY=4
